OPENAI_API_KEY=
# Optional. Defaults to gpt-5.4-mini in code when unset.
OPENAI_PUBLISHING_MODEL=gpt-5.4-mini

# YouTube private upload OAuth credentials.
# The refresh token must be issued with the https://www.googleapis.com/auth/youtube.upload scope.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional. Defaults to http://localhost:3000/api/youtube/oauth/callback during local dev.
YOUTUBE_REDIRECT_URI=
